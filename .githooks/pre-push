#!/bin/bash
# What .github/workflows/swift.yml used to do, on this machine, because the
# GitHub Actions minutes ran out. Keep the two in step: a check added here
# belongs there too, for whenever the workflow runs again.
#
# Install once:   git config core.hooksPath .githooks
# Skip one push:  git push --no-verify
#
# It deliberately does NOT run tools/generate_project.swift. That rewrites
# project.pbxproj and clears xcuserdata, which corrupts the project when Xcode
# has it open (AGENTS.md Workflow 4), so the check below is read-only instead.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

output="$(mktemp)"
trap 'rm -f "$output"' EXIT
failed=""

run() {
    local name="$1"
    shift
    printf '  %-22s' "$name"
    if "$@" > "$output" 2>&1; then
        echo "ok"
    else
        echo "FAILED"
        sed 's/^/    /' "$output" | tail -25
        failed="$failed $name"
    fi
}

# Every .swift file on disk is in the project file, and nothing extra is.
# "sourcecode.swift" is Xcode's file-type token, not a file.
project_lists_every_file() {
    diff \
        <(grep -oE '[A-Za-z0-9_]+\.swift' MenteViva.xcodeproj/project.pbxproj \
            | grep -v '^sourcecode\.swift$' | sort -u) \
        <(find MenteViva MenteVivaTests -name '*.swift' -exec basename {} \; | sort -u) || {
        echo "Close Xcode, run 'swift tools/generate_project.swift', commit the result."
        return 1
    }
}

simulator() {
    local booted
    booted="$(xcrun simctl list devices available \
        | awk '/\(Booted\)/{match($0,/[0-9A-F-]{36}/); print substr($0,RSTART,RLENGTH); exit}')"
    if [ -n "$booted" ]; then
        echo "$booted"
        return
    fi
    xcrun simctl list devices available \
        | awk '/iPhone/{match($0,/[0-9A-F-]{36}/); print substr($0,RSTART,RLENGTH); exit}'
}

echo "Pre-push checks (git push --no-verify to skip):"
run "lint" xcrun swift-format lint --strict -r MenteViva MenteVivaTests tools
run "signposts vs docs" ./tools/check_signposts.sh
run "project file" project_lists_every_file

udid="$(simulator)"
if [ -n "$udid" ]; then
    run "build + test" xcodebuild test \
        -project MenteViva.xcodeproj -scheme MenteViva -destination "id=$udid"
else
    printf '  %-22s%s\n' "build + test" "FAILED"
    echo "    No iPhone simulator available. Open Xcode once, or push with --no-verify."
    failed="$failed build+test"
fi

if [ -z "$failed" ]; then
    echo "All checks passed."
    exit 0
fi
echo
echo "Push stopped:$failed"
echo "Fix it, or push anyway with: git push --no-verify"
exit 1
