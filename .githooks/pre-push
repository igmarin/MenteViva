#!/bin/bash
# The local twin of CI (.github/workflows/checks.yml + swift.yml): the same
# checks, run before every push so CI rarely has anything to catch. Keep them in
# step: a check added here belongs in one of the workflows too (AGENTS.md
# Workflow 5).
#
# Install once:   git config core.hooksPath .githooks
# Skip one push:  git push --no-verify
# Own simulator:  MENTEVIVA_SIMULATOR=<udid> git push   (parallel agents each
#                 pass their own, or the tests reinstall over a booted one in use)
#
# It deliberately does NOT run tools/generate_project.swift. That rewrites
# project.pbxproj and clears xcuserdata, which corrupts the project when Xcode
# has it open (AGENTS.md Workflow 4), so the check below is read-only instead.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

output="$(mktemp)"
trap 'rm -f "$output"' EXIT
failed=""

run() {
    local name="$1"
    shift
    printf '  %-22s' "$name"
    if "$@" > "$output" 2>&1; then
        echo "ok"
    else
        echo "FAILED"
        sed 's/^/    /' "$output" | tail -25
        failed="$failed $name"
    fi
}

simulator() {
    if [ -n "${MENTEVIVA_SIMULATOR:-}" ]; then
        echo "$MENTEVIVA_SIMULATOR"
        return
    fi
    local booted
    booted="$(xcrun simctl list devices available \
        | awk '/\(Booted\)/{match($0,/[0-9A-F-]{36}/); print substr($0,RSTART,RLENGTH); exit}')"
    if [ -n "$booted" ]; then
        echo "$booted"
        return
    fi
    xcrun simctl list devices available \
        | awk '/iPhone/{match($0,/[0-9A-F-]{36}/); print substr($0,RSTART,RLENGTH); exit}'
}

echo "Pre-push checks (git push --no-verify to skip):"
run "lint" xcrun swift-format lint --strict -r MenteViva MenteVivaTests tools
run "claims" ./tools/check_claims.sh
run "signposts vs docs" ./tools/check_signposts.sh
run "project file" ./tools/check_project_files.sh
run "site placeholders" ./tools/check_site.sh
run "sliding blocks drift" sh -c '
    swift -O tools/generate_sliding_blocks.swift \
        || { echo "tools/generate_sliding_blocks.swift failed (see above)."; exit 1; }
    git diff --exit-code -- MenteViva/Games/SlidingBlocksLevels.swift \
        || { echo "SlidingBlocksLevels.swift was regenerated; commit it."; exit 1; }'

udid="$(simulator)"
if [ -n "$udid" ]; then
    run "build + test" xcodebuild test \
        -project MenteViva.xcodeproj -scheme MenteViva -destination "id=$udid"
else
    printf '  %-22s%s\n' "build + test" "FAILED"
    echo "    No iPhone simulator available. Open Xcode once, or push with --no-verify."
    failed="$failed build+test"
fi

if [ -z "$failed" ]; then
    echo "All checks passed."
    exit 0
fi
echo
echo "Push stopped:$failed"
echo "Fix it, or push anyway with: git push --no-verify"
exit 1
