      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic moves at most one step a week, based on how the games go. A level you choose stays until you switch back to Automatic, which then continues from it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La automática cambia como mucho un paso por semana, según cómo van los juegos. Un nivel que elijas se mantiene hasta que vuelvas a Automática, que sigue desde ese nivel."
          }
        }
      }
    },
