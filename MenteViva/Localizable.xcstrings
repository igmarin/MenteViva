    "settings.privacy.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ads. No tracking. No account. Your games stay on your device. If daily suggestions are on, only anonymous totals leave it — which games, how many, how well. Never your name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin anuncios. Sin rastreo. Sin cuenta. Tus partidas se quedan en tu dispositivo. Si las sugerencias diarias están activas, solo salen totales anónimos: qué juegos, cuántos y qué tan bien. Nunca tu nombre."
          }
        }
      }
    },
